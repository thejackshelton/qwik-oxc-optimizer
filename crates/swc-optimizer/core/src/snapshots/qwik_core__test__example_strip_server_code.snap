    const b = client$(() => {
      // from clien$(), should not be removed
    });
    return [a, b];
  });

  serverLoader$(handler);

  useTask$(() => {
    // Code
  });

  return <div onClick$={() => console.log("parent")}>{state.text}</div>;
});

