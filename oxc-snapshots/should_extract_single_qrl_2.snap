import { useSignal } from "@qwik.dev/core";
import { useStore } from "@qwik.dev/core";
export const Parent_component_0TaiDayHrlo = () => {
	const cart = useStore<Cart>([]);
	const results = useSignal(["foo", "bar"]);
	return <div>
          <button></button>

          {results.value.map((item, key) => <button>
              {item}
            </button>)}
          <ul>
            {cart.map((item) => <li>
                <span>{item}</span>
              </li>)}
          </ul>
        </div>;
};;

