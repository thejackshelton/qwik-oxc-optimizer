import { useSignal } from "@qwik.dev/core";
//
export const test_component_LUXeXe0DQrg = () => {
	const matrix = useSignal([["a", "b"], ["c", "d"]]);
	return <div>
      {matrix.value.map((row, i) => {
		const rowIndex = i + 1;
		return <div>
            {row.map((cell, j) => {
			const cellIndex = j + 1;
			const cellKey = rowIndex + "-" + cellIndex;
			return <span>
                  <button>{cell}</button>
                  <span>{cellKey}</span>
                </span>;
		})}
          </div>;
	})}
    </div>;
};

