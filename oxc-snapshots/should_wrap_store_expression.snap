						'examples-panel-input': panelStore.active === 'Input',
						'examples-panel-output': panelStore.active === 'Output',
						'examples-panel-console': panelStore.active === 'Console',
					}}
				/>
			);
		});
		export const PANELS: ActivePanel[] = ['Examples', 'Input', 'Output', 'Console'];
		

